# Supabase Postgres (shared project). Connect as the restricted fightcenter_sync role
# through the transaction-mode pooler (port 6543); the pooler username is
# fightcenter_sync.<project-ref>, e.g.
# postgresql://fightcenter_sync.abcdefghijklmnop:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
# Schema holding FightCenter's tables (default shown)
DB_SCHEMA=fightcenter
# Base64 of Supabase's root CA cert (Dashboard → Project Settings → Database → SSL →
# Download certificate). Required in production; locally, the connection is unverified without it.
SUPABASE_DB_CA_B64=
# Base64 of the mma-scrape-reader service account JSON key (read-only BigQuery).
# Leave unset locally to use `gcloud auth application-default login` instead.
GCP_SA_KEY_B64=
# Optional overrides (defaults shown)
BIGQUERY_PROJECT=ufc-data-pipeline
BIGQUERY_DATASET=analytics
# Key for POST /sync (x-api-key header), used by the cron-job.org trigger. SCRAPER_KEY also accepted.
ADMIN_API_KEY=
# Comma-separated allowed CORS origins
CORS_ORIGIN=
